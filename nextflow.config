manifest {
  homePage = 'https://github.com/RibosomeCRCL/ribomethseq-nf'
  description = 'RiboMethSeq data processing'
  mainScript = 'main.nf'
  name = 'ribomethseq-nf'
  author = 'Hermes Paraqindes, Theo Combe'
  version = '1.1'
}

/***************************************************************/
/*                  Nextflow execution reporting               */
/***************************************************************/
params.outdir      = '.'
params.logdir      = params.outdir
params.report_dir  = params.logdir
params.report_base = 'ribomethseq-nf.report'

report {
  enabled = true
  file = "${params.report_dir}/${params.report_base}/exec-report.html"
}

trace {
  enabled = true
  fields = 'process,task_id,hash,name,attempt,status,exit,realtime,cpus,memory,%cpu,vmem,rss,submit,start,complete,duration,realtime,rchar,wchar'
  file = "${params.report_dir}/${params.report_base}/exec-trace.txt"
}

/***************************************************************/
/*                  Nextflow execution parameters              */
/***************************************************************/

profiles {
  docker {
    includeConfig "nf-config/exec.config"
    docker.enabled = true
    process.container = 'ghcr.io/ribosomecrcl/ribomethseq-nf:1.1'
    // Mount the pipeline dir so the bundled references/index (passed as a
    // path, not staged) are visible inside the container. Append extra
    // mounts of your infrastructure here if needed.
    process.containerOptions = "-v ${baseDir}:${baseDir}"
  }
  singularity {
    includeConfig "nf-config/exec.config"
    singularity.enabled = true
    singularity.autoMounts = true
    // The .sif is pulled & converted automatically from the GHCR image into
    // the cache dir (default: $NXF_SINGULARITY_CACHEDIR). Override if needed:
    // singularity.cacheDir = '/path/to/singularity/cache'
    process.container = 'ghcr.io/ribosomecrcl/ribomethseq-nf:1.1'
    process.containerOptions = "--bind ${baseDir}"
  }
  human {
    includeConfig "nf-config/human.config"
  }
  human_full {
    includeConfig "nf-config/human_full.config"
  }
  mouse {
    includeConfig "nf-config/mouse.config"
  }
}
