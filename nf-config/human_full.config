// Human profile with the extended reference set: 4 rRNA + 6 snRNA.
// The bowtie2 index (data/bowtie/human_full/) bundles, in order:
//   rRNA  : NR_046235.3_5.8S / _18S / _28S, NR_023363.1_5S
//   snRNA : U1, U2, U4, U5, U6, U12
//
// All references are reported automatically by the QC report, and the optional
// --split step now handles any number of references (rRNA + snRNA).

params {
  species         = "Human (extended panel: rRNA + snRNA)"
  bowtie_index    = "$baseDir/data/bowtie/human_full/human_full_index"
  // multi-FASTA backing the index above; used by the optional --split step
  // to annotate each position with its nucleotide.
  reference_fasta = "$baseDir/data/bowtie/human_full/Human_full.fa"
}
